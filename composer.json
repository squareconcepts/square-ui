{
    "name": "squareconcepts/square-ui",
    "description": "Collection of blade and livewire components",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "livewire/flux": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "livewire/flux-pro": "Required for the date/time pickers (flux:calendar, flux:select variant=\"listbox\") and for the Flux replacements of the deprecated components (flux:date-picker, flux:time-picker, flux:file-upload, flux:autocomplete, flux:pillbox, flux:popover)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Squareconcepts\\SquareUi\\Providers\\SquareUiServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Squareconcepts\\SquareUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Squareconcepts\\SquareUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "SQUARE Concepts",
            "email": "info@squareconcepts.nl"
        }
    ]
}
